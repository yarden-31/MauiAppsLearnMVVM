<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MVVMBBasic"
    xmlns:views="clr-namespace:Views"
    Title="MVVMBBasic">

    <!-- Welcome Menu -->
    <FlyoutItem Title="Welcome">
        <ShellContent
        Title="Welcome"
        Route="WelcomeMenu"
        ContentTemplate="{DataTemplate views:WelcomeMenuPage}"/>
    </FlyoutItem>

    <!-- Temperature Calculator -->
    <FlyoutItem Title="Temperature Calculator">
        <ShellContent
        Title="Temperature Calculator"
        Route="TemperatureCalculator"
        ContentTemplate="{DataTemplate views:TemperatureCalculatorPage}"/>
    </FlyoutItem>

    <!-- Age Calculator -->
    <FlyoutItem Title="Calculator Age">
        <ShellContent
        Title="Calculator Age"
        Route="CalcAge"
        ContentTemplate="{DataTemplate views:CalcAgePage}"/>
    </FlyoutItem>

    <!-- Math Calculator -->
    <FlyoutItem Title="Math Calculator">
        <ShellContent
        Title="Math Calculator"
        Route="Calculator"
        ContentTemplate="{DataTemplate views:CalculatorPage}"/>
    </FlyoutItem>

</Shell>
