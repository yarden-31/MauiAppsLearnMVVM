<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Views"
             xmlns:vm="clr-namespace:ViewModels"
             x:DataType="vm:TemperatureCalculatorViewModel"
             x:Class="Views.TemperatureCalculatorPage"
             Title="TemperatureCalculatorPage">
    
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        
        <!--Entry for Fahrenheit temperature input-->
        <Entry Text="{Binding TemperatureFahrenheit}" 
               Placeholder="Enter temperature in Fahrenheit" 
               Keyboard="Numeric" />

        <!--Button to trigger conversion to Celsius-->
        <Button Text="Convert to Celsius" 
                Command="{Binding ConvertToCelsiusCommand}" />

        <!--Label to display the result in Celsius-->
        <Label Text="{Binding Result}" 
               FontSize="20" 
               HorizontalOptions="Center" />
        
        
    </VerticalStackLayout>
</ContentPage>